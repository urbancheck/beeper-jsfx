desc: Mix Protection Beeper

slider1:interval=10<1,60,1>Time between beeps (seconds)
slider2:duration=1<0.1,5,0.1>Beep duration (seconds)
slider3:gain_db=-12<-60,0,1>Beep volume (dB)

@init
timer = 0;
phase = 0;

@sample
timer += 1;
timer >= interval * srate ? timer = 0;

timer < duration * srate ? (
  phase += 2 * $pi * 1000 / srate;
  beep = sin(phase) * 10 ^ (gain_db / 20);
  spl0 += beep;
  spl1 += beep;
);
